# Runtime only. Empty database URLs allow the web UI's unavailable state.
# Supply your external PostgreSQL connection URL locally; never commit secrets.
DATABASE_URL=
# Separate schema/ingestion role for explicitly invoked maintenance jobs.
MARKET_DATABASE_URL=
GOOGLE_CLOUD_API_KEY=
REAL_ESTATE_DASHBOARD_PITI_STORAGE_KEY=
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOSTNAME=127.0.0.1
WEB_PORT=3000
# Illustrative house-market preference criteria (not a citywide inventory filter).
MARKET_PREF_MAX_PRICE=480000
MARKET_PREF_MIN_YEAR_BUILT=1900
MARKET_PREF_MAX_YEAR_BUILT=1965
